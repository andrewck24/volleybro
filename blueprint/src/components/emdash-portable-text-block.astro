---
import type { ComponentProps } from "astro/types";
import { emdashComponents } from "emdash/ui";

const EmDashPortableTextBlock = emdashComponents.block;

const props = Astro.props as ComponentProps<typeof EmDashPortableTextBlock> & {
  node: { id?: string };
};
const blockProps = { ...props, id: props.node.id };
---

<EmDashPortableTextBlock {...blockProps}><slot /></EmDashPortableTextBlock>
