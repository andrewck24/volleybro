{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volleybro.dev/blueprint/change.schema.json",
  "title": "Blueprint Change metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "title",
    "status",
    "lifecycle",
    "startedAt",
    "summary",
    "capabilities",
    "tags"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["discussing", "in-progress", "archived"]
    },
    "lifecycle": {
      "enum": [
        "discussing",
        "proposing",
        "ready-for-review",
        "ready-for-implementation",
        "applying",
        "ingesting",
        "pre-pr-review",
        "awaiting-delivery-review",
        "archived"
      ]
    },
    "startedAt": { "type": "string", "format": "date" },
    "archivedAt": { "type": "string", "format": "date" },
    "summary": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)*$" }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "archived" } } },
      "then": {
        "required": ["archivedAt"],
        "properties": { "lifecycle": { "const": "archived" } }
      }
    },
    {
      "if": { "properties": { "status": { "const": "discussing" } } },
      "then": { "properties": { "lifecycle": { "const": "discussing" } } }
    }
  ]
}
