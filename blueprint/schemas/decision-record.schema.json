{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volleybro.dev/blueprint/decision-record.schema.json",
  "title": "Blueprint decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "capabilities",
    "decision"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^D[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)+$"
      }
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option",
          "reason"
        ],
        "properties": {
          "option": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "consequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revisitTriggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "originChange": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "supersededBy": {
      "type": "string",
      "pattern": "^D[0-9]+$"
    }
  }
}
