    "sharp": "^0.35.4",
    "storybook": "^10.5.10",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsgo": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3"
  }
