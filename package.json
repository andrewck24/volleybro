{
  "name": "volleybro",
  "version": "0.16.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yml,yaml}": "prettier --write"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "node node_modules/tsgo/bin/tsc --noEmit",
    "typecheck:strict": "node node_modules/typescript/bin/tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.js",
    "verify:all": "node scripts/verify.js --all",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "test": "jest --selectProjects backend frontend",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
    "test:workflow": "node --test scripts/__tests__/*.test.js",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "release:version": "changeset version && node .changeset/changelog-postprocess.js",
    "blueprint": "node scripts/blueprint.js",
    "blueprint:changes:pull": "node scripts/blueprint-changes.js pull",
    "blueprint:changes:publish": "node scripts/blueprint-changes.js publish",
    "blueprint:gate": "node scripts/blueprint-gate.js",
    "generate-icons": "node scripts/generate-icons.js",
    "check:workflow": "node scripts/check-workflow.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@next/bundle-analyzer": "^16.3.8",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@reduxjs/toolkit": "^2.13.0",
    "@serwist/turbopack": "^9.5.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "inversify": "^8.2.3",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "swr": "^2.5.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^5.4.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@jest/globals": "^30.5.2",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chromatic": "^18.11.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "jest-fixed-jsdom": "^0.0.11",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "mongodb-memory-server": "^11.3.0",
    "msw": "^3.0.2",
    "next-themes": "^0.4.6",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "storybook": "^10.6.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsgo": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  }
}
