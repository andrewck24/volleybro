{
  "name": "volleybro",
  "version": "0.14.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "node node_modules/tsgo/bin/tsc --noEmit",
    "typecheck:strict": "node node_modules/typescript/bin/tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm test:workflow && pnpm check:workflow && pnpm typecheck:strict && pnpm lint && pnpm test",
    "verify:all": "pnpm verify && pnpm --filter blueprint test && pnpm build && node scripts/assert-sw.js && pnpm --filter blueprint build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "test": "jest --selectProjects backend frontend",
    "test:integration": "jest --selectProjects integration",
    "test:workflow": "node --test scripts/__tests__/check-workflow.test.js",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "release:version": "changeset version && node .changeset/changelog-postprocess.js",
    "blueprint": "node scripts/blueprint.js",
    "generate-icons": "node scripts/generate-icons.js",
    "check:workflow": "node scripts/check-workflow.js"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
