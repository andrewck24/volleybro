# Copy to .env.local and fill in the values; .env.local is gitignored.

# Required

# MongoDB connection string (MongoDB Atlas). Read at build time as well as at runtime.
MONGODB_URI=
# Google OAuth client, from Google Cloud Console > APIs & Services > Credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public base URL, read by Better Auth itself; http://localhost:3000 for local development.
BETTER_AUTH_URL=http://localhost:3000
# Session signing secret, read by Better Auth itself. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional

# Comma-separated hosts, besides localhost, allowed to reach the dev server — e.g. this
# machine's LAN IP (ipconfig getifaddr en0) for testing on a phone, or a tunnel domain.
ALLOWED_DEV_ORIGINS=
# true enables @next/bundle-analyzer, which runs only on a webpack build (next build --webpack).
ANALYZE=
# true sends noindex headers, for preview deployments.
DISALLOW_INDEXING=
